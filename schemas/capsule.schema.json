      "type": "object"
    },
    "EvidencePlane": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "propertyNames": {
            "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": "Extensions",
          "type": "object"
        },
        "records": {
          "items": {
            "discriminator": {
              "mapping": {
                "CAS": "#/$defs/CASEvidence",
                "EXTERNAL_IMMUTABLE": "#/$defs/ExternalImmutableEvidence",
                "GIT_IMMUTABLE": "#/$defs/GitImmutableEvidence"
              },
              "propertyName": "mode"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CASEvidence"
              },
              {
                "$ref": "#/$defs/GitImmutableEvidence"
              },
              {
                "$ref": "#/$defs/ExternalImmutableEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "records"
      ],
      "title": "EvidencePlane",
      "type": "object"
    },
